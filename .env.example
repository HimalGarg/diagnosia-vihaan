# ==============================================================================
# Curai Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys for your local development or pilot.
# NEVER commit the real .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI & INFERENCE PROVIDERS (Optional for offline mock tests)
# ------------------------------------------------------------------------------
# Groq: Powers ultra-low-latency Whisper audio transcription, Conversational extraction,
# and ambient scribing. Get a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini: Powers multimodal vision for handwritten prescriptions and scanned lab reports.
# Get a free API key at: https://aistudio.google.com/apikey
# With both keys set, Gemini acts as automatic fallback for Groq, or vice-versa based on strategy.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom OpenAI-compatible endpoints (e.g., local vLLM or Ollama instance)
# AI_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ------------------------------------------------------------------------------
# 2. APPLICATION ENVIRONMENT & STORAGE
# ------------------------------------------------------------------------------
# Environment: 'development', 'staging', or 'production'
CURAI_ENV=development

# Primary SQLite database path (parameterized queries, WAL mode enabled)
CURAI_DB=backend/storage/curai.db

# Storage path for original encrypted clinical documents (PDFs, prescription photos, audio)
CURAI_DOCUMENTS=backend/storage/documents

# Master AES-256-GCM Document Encryption Key file.
# Generate via: python -m backend.operator_cli generate-key --path ~/.curai/document-keys.json
# File MUST be stored outside the repository with restricted filesystem permissions.
CURAI_DOCUMENT_KEY_FILE=~/.curai/document-keys.json

# Production security: Set to 1 in HTTPS-secured production to enforce Secure cookies and HSTS.
# Keep 0 for plain localhost HTTP development.
CURAI_HTTPS=0

# Idle session timeout in minutes (sliding window). 0 disables idle expiration.
CURAI_SESSION_IDLE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. SAFETY, REGULATORY & PILOT GUARDS
# ------------------------------------------------------------------------------
# Pilot mode guard: 1 restricts operations to synthetic demonstration only.
CLINICAL_PILOT_MODE=1

# Real patient data lock: MUST remain 0 until CDSCO, DPDP, and institutional security reviews pass.
ALLOW_REAL_PATIENT_DATA=0

# Demo mode toggle: Pre-seeds synthetic patient and clinician profiles for demonstrations.
CURAI_DEMO_MODE=1

# External messaging: Set to 1 only when approved SMS/WhatsApp gateways are connected.
ENABLE_EXTERNAL_MESSAGING=0

# ------------------------------------------------------------------------------
# 4. CLINICAL TOOL SETTINGS
# ------------------------------------------------------------------------------
# DiagnoFast Kiosk: Set to numeric user ID of verified doctor to enable public waiting-room kiosk.
# Leaving blank restricts DiagnoFast to reception-generated patient links.
DIAGNOFAST_KIOSK_DOCTOR_ID=

# Validity period (in hours) for unopened DiagnoFast patient interview tokens
CURAI_DIAGNOFAST_LINK_HOURS=24

# Time limit (in hours) to complete an active in-progress DiagnoFast interview
CURAI_DIAGNOFAST_INTERVIEW_HOURS=2

# Neural Text-to-Speech: 1 enables Microsoft Edge neural voices (Neerja for English-IN, Swara for Hindi).
# Set to 0 to fallback to Groq audio synthesis or client-side Web Speech API.
CURAI_NEURAL_TTS=1

# Indian Pharmaceutical Registry dataset (CSV containing generic and brand names).
# Used by Prescription Analyzer for fuzzy matching against ~250,000 medicine listings.
CURAI_MEDICINE_LIST=datasets/medicines/indian-medicine-dataset/DATA/indian_medicine_data.csv

# ------------------------------------------------------------------------------
# 5. ENTERPRISE INTEGRATIONS (Optional - Off by default)
# ------------------------------------------------------------------------------
# MongoDB Atlas (CareFlow Event Store & Real-Time Projections)
ENABLE_MONGODB_ATLAS_INTEGRATION=false
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=curai_atlas
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# MongoDB Change Streams (powers instant, zero-refresh CareFlow timeline updates)
ENABLE_MONGODB_CHANGE_STREAMS=false
MONGODB_CHANGE_STREAM_COLLECTION=care_events

# YugabyteDB (Distributed SQL ledger for AI run logs, prompt attempts & agent handoffs)
ENABLE_YUGABYTEDB_INTEGRATION=false
YUGABYTEDB_YSQL_DSN=postgresql://yugabyte:password@127.0.0.1:5433/curai_execution
YUGABYTEDB_POOL_MAX_SIZE=4

# Meko MCP Integration (Shared agent context, medical knowledge base & memory)
ENABLE_MEKO_INTEGRATION=false
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
MEKO_DATAPACK_ID=
ENABLE_MEKO_PATIENT_PACKS=false
MEKO_PACK_LIMIT=6

# ------------------------------------------------------------------------------
# 6. RELIABILITY, OUTBOX & RATE LIMITS
# ------------------------------------------------------------------------------
# Transactional Outbox Worker configuration
EVENT_DELIVERY_BATCH_SIZE=50
EVENT_DELIVERY_MAX_ATTEMPTS=8
EVENT_DELIVERY_BACKOFF_SECONDS=30

# Daily AI circuit breaker per deployment (prevents runaway cloud API costs)
CURAI_AI_DAILY_TOKENS=5000000
CURAI_AI_DAILY_SPEND_USD=25.0
CURAI_AI_PRICES={}
